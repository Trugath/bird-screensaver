{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Window (demo)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BirdScreensaver/bin/Debug/net9.0-windows/BirdScreensaver.exe",
      "args": ["--window", "--demo"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Window (live mic)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BirdScreensaver/bin/Debug/net9.0-windows/BirdScreensaver.exe",
      "args": ["--window"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Configure",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BirdScreensaver/bin/Debug/net9.0-windows/BirdScreensaver.exe",
      "args": ["configure"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Screensaver /s",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BirdScreensaver/bin/Debug/net9.0-windows/BirdScreensaver.exe",
      "args": ["/s"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Preview PNG",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BirdScreensaver/bin/Debug/net9.0-windows/BirdScreensaver.exe",
      "args": ["--preview", "${workspaceFolder}/preview.png", "--demo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Fetch assets",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BirdScreensaver/bin/Debug/net9.0-windows/BirdScreensaver.exe",
      "args": ["fetch-assets"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Fetch model",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BirdScreensaver/bin/Debug/net9.0-windows/BirdScreensaver.exe",
      "args": ["fetch-model"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
