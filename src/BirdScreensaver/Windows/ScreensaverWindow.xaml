<Window x:Class="BirdScreensaver.Windows.ScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bird screensaver"
        Background="#F2EDE2"
        WindowStartupLocation="Manual">
    <Grid>
        <Image x:Name="PageImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="24,0,24,20"
                   Foreground="#5A5348"
                   FontSize="16"
                   FontFamily="Georgia"/>
    </Grid>
</Window>
