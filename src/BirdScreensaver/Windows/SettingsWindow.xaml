<Window x:Class="BirdScreensaver.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bird screensaver"
        Width="460"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F2EDE2">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Bird screensaver" FontFamily="Georgia" FontSize="22" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Microphone"/>
                <ComboBox x:Name="MicrophoneBox"/>
                <Label Content="BirdNET region"/>
                <ComboBox x:Name="RegionBox"
                          MaxDropDownHeight="240"
                          SelectionChanged="OnRegionChanged"/>
                <Label Content="Confidence"/>
                <DockPanel>
                    <TextBlock x:Name="ConfidenceLabel" DockPanel.Dock="Right" Width="40" Text="0.65"/>
                    <Slider x:Name="Confidence" Minimum="0.3" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnConfidence"/>
                </DockPanel>
                <Label Content="Stay on the page (minutes)"/>
                <TextBox x:Name="Lookback"/>
                <Label Content="Max birds (0 = no cap)"/>
                <TextBox x:Name="MaxBirds"/>
                <CheckBox x:Name="ShowNames" Content="Show scientific names" Margin="0,12,0,8"/>
                <CheckBox x:Name="Demo" Content="Demo garden (no microphone)" Margin="0,0,0,12"/>
                <TextBlock x:Name="ModelStatus" TextWrapping="Wrap" Foreground="#5A5348" Margin="0,0,0,8"/>
                <Button Content="Download BirdNET model" Click="OnDownload" Margin="0,0,0,8" Padding="8"/>
                <Button Content="Fetch plates from Fugleramme" Click="OnFetch" Padding="8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Install" Width="90" Margin="0,0,8,0" Padding="8" Click="OnInstall"/>
            <Button Content="OK" Width="90" IsDefault="True" Padding="8" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
