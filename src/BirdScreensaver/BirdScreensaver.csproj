<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>BirdScreensaver.Program</StartupObject>
    <AssemblyName>BirdScreensaver</AssemblyName>
    <RootNamespace>BirdScreensaver</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <Target Name="StageScreensaverPayload" AfterTargets="Publish">
    <PropertyGroup>
      <_PlatesRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\assets'))</_PlatesRoot>
    </PropertyGroup>
    <Copy SourceFiles="$(PublishDir)BirdScreensaver.exe" DestinationFiles="$(PublishDir)BirdScreensaver.scr" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_PlateFiles Include="$(_PlatesRoot)\**\*.*" Condition="Exists('$(_PlatesRoot)\artwork\classic\birds')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_PlateFiles)"
      DestinationFiles="@(_PlateFiles->'$(PublishDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_PlateFiles)' != ''" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="BirdScreensaver.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>
</Project>
