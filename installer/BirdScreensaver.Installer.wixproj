<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>BirdScreensaver-0.1.0-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../artifacts/app'))</PublishDir>
    <!-- Per-user file keypaths trip ICE38/ICE64; ICE91/ICE60 are the plates. -->
    <SuppressIces>ICE38;ICE64;ICE91;ICE60</SuppressIces>
  </PropertyGroup>
  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)../src/BirdScreensaver/BirdScreensaver.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(PublishDir)\" />
  </Target>
  <Target Name="CopyMsiToDist" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)../dist" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(MSBuildThisFileDirectory)../dist/$(OutputName).msi"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
